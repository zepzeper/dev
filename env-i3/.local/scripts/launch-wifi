#!/usr/bin/env bash
# Launch the network manager TUI (wlctl), which covers wifi and VPN profiles.
#
# This is the gap the README recorded for a long time. Omarchy uses impala here
# and impala is the nicer-looking tool, but it drives iwd - no use on a machine
# whose wifi and OpenVPN profile both live in NetworkManager, and iwd cannot do
# the 802.1X a work network may ask for. impala's maintainer turned down a
# NetworkManager backend, so wlctl exists to be exactly that, and replaces the
# nmtui this used to open.

# An rfkill soft block makes the network list come up empty with no
# explanation, which reads as "nothing in range" rather than "the radio is off".
rfkill unblock wifi 2>/dev/null

exec launch-or-focus-tui wlctl
