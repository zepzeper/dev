# i3, mirroring the Hyprland bindings in env-hypr so muscle memory carries
# between the two sessions - the laptop has only this one, the workstation can
# log into either.
#
# Where Hyprland has no i3 equivalent the binding is left commented with the
# reason, rather than silently dropped.

set $mod Mod4

font pango:Iosevka Term 10

# Hand the session over to systemd before anything else starts.
#
# Two separate jobs, in this order and in one shell so they cannot race: the
# user manager and the D-Bus activation environment inherit nothing from an X
# session by themselves - gdm exports DISPLAY and XAUTHORITY but not
# XDG_CURRENT_DESKTOP, which is what picks the portal backend - and
# graphical-session.target is not reached until something starts it. Without
# both, xdg-desktop-portal never runs and every app that asks the desktop
# whether it is dark gets no answer. See .config/systemd/user/i3-session.target.
exec_always --no-startup-id sh -c 'dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE; systemctl --user start i3-session.target'

# monitor applies the layout once, now; monitor-watch keeps applying it as the
# lid and the cable move. Both are exec_always so an i3 reload revives them,
# and monitor-watch holds a lock so the reload does not stack up watchers.
exec_always --no-startup-id ~/.config/i3/monitor
exec_always --no-startup-id ~/.config/i3/monitor-watch
exec_always --no-startup-id /usr/bin/flameshot 
exec_always --no-startup-id /usr/bin/feh --bg-scale ~/Wallpapers/dune.jpg

# Hyprland uses ALT+drag to move and SUPER+drag to resize; i3 has one modifier
# for both, so ALT matches the more common of the two.
floating_modifier Mod1

default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart

# launch-tui tags each terminal zepzeper.<tool>. Float them centred at the same
# 875x600 env-hypr's floating-window rule uses, so a TUI opens identically on
# either machine. Matching on instance rather than class is deliberate: ghostty
# fills both WM_CLASS fields from separate options and launch-tui sets each.
for_window [instance="^zepzeper\."] floating enable, resize set 875 600, move position center

# ------------------------------------------------------------------
# Applications
# ------------------------------------------------------------------
set $term /usr/bin/ghostty

# Hyprland's terminal binding, kept for parity on the laptop.
bindsym $mod+Shift+Delete exec --no-startup-id "$term"
bindsym $mod+Shift+f exec --no-startup-id nautilus --new-window
bindsym $mod+Shift+b exec --no-startup-id xdg-open "https://home.krugten.org"
bindsym $mod+Shift+t exec --no-startup-id "$term -e btop || x-terminal-emulator -e btop"

# System controls, all TUIs in a floating terminal - the same tools the
# workstation uses, so the habits carry. launch-or-focus-tui means a second
# press focuses the open window instead of stacking another one up.
bindsym $mod+b       exec --no-startup-id launch-bluetooth
bindsym $mod+Shift+a exec --no-startup-id launch-audio
bindsym $mod+Shift+n exec --no-startup-id launch-wifi
# Not $mod+Shift+v, which is already split horizontal.
bindsym $mod+Ctrl+v  exec --no-startup-id launch-vpn

bindsym $mod+BackSpace exec --no-startup-id launch-menu apps
bindsym $mod+d      exec --no-startup-id rofi -show run

# Webapps. Hyprland uses launch-webapp, which shells out to uwsm-app and so is
# Wayland-only; xdg-open is the portable stand-in but opens a normal tab rather
# than an app window.
bindsym $mod+Shift+g exec --no-startup-id xdg-open "https://github.com/zepzeper"
bindsym $mod+Shift+w exec --no-startup-id xdg-open "https://web.whatsapp.com/"
bindsym $mod+Shift+d exec --no-startup-id xdg-open "https://excalidraw.com/"
bindsym $mod+Shift+x exec --no-startup-id xdg-open "https://x.com/"
bindsym $mod+Shift+m exec --no-startup-id xdg-open "https://mastodon.social/home/"
bindsym $mod+Shift+o exec --no-startup-id sh -c 'XDG_CURRENT_DESKTOP=GNOME gnome-control-center'

bindsym $mod+Ctrl+l exec --no-startup-id loginctl lock-session

# Re-apply the display layout by hand, for the monitor that comes back in a
# state xrandr misreported.
bindsym $mod+Shift+s exec --no-startup-id ~/.config/i3/monitor

# ------------------------------------------------------------------
# Locking
# ------------------------------------------------------------------
# One locker, three ways into it: the keybinding above, the idle timeout, and
# logind on its way to suspend. xss-lock is what unifies them - it watches both
# the X screensaver timer and logind's Lock and PrepareForSleep signals - so
# there is a single i3lock to configure rather than three.
#
# --transfer-sleep-lock hands i3lock logind's inhibitor fd, which is what makes
# the lock appear *before* the machine suspends instead of racing it; without
# it the desktop can be briefly visible on resume. It is also what covers the
# laptop's lid: runs/i3 leaves HandleLidSwitch=suspend, and the suspend is what
# triggers the lock.
#
# -n (nofork) is required rather than cosmetic: xss-lock tracks the locker as
# its own child, and a locker that forks away looks like it exited at once, so
# xss-lock would consider the screen unlocked while i3lock is still up.
set $locker i3lock -n -c 161521 -e -f

# pkill first: this is exec_always, so every i3 restart would otherwise leave
# another xss-lock behind, and two of them race to lock the same screen.
#
# Worth knowing when testing any of the exec_always lines above: i3 re-runs
# them on *restart* ($mod+Ctrl+r), not on reload ($mod+Shift+c). A reload
# re-reads the config and changes bindings, and looks like it did nothing at
# all here.
exec_always --no-startup-id sh -c 'pkill -x xss-lock; exec xss-lock --transfer-sleep-lock -- $locker'

# The idle timer xss-lock waits on is X's screensaver, not DPMS: `xset s
# <timeout> <cycle>`, so this locks after 10 minutes idle. The cycle only
# matters to screensavers that redraw, which a blank one does not.
exec_always --no-startup-id xset s 600 600

# Power the panel down five minutes after that, rather than leaving a 4K screen
# lit all night. standby and suspend are disabled (0); only "off" is set.
exec_always --no-startup-id xset dpms 0 0 900

# ------------------------------------------------------------------
# Windows
# ------------------------------------------------------------------
bindsym $mod+q kill

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Hyprland resizes with bare ALT+hjkl, no resize mode.
bindsym Mod1+h resize grow   width  100 px
bindsym Mod1+l resize shrink width  100 px
bindsym Mod1+k resize shrink height 100 px
bindsym Mod1+j resize grow   height 100 px

bindsym $mod+t floating toggle
bindsym $mod+f fullscreen toggle
bindsym $mod+e focus mode_toggle

# No i3 equivalent: $mod+p (pseudo), $mod+o (launch-window-pop, hyprctl only),
# $mod+Alt+f (maximized as distinct from fullscreen).

bindsym $mod+v split vertical
bindsym $mod+Shift+v split horizontal

# ------------------------------------------------------------------
# Workspaces
# ------------------------------------------------------------------
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# ------------------------------------------------------------------
# Screenshot / system
# ------------------------------------------------------------------
bindsym Ctrl+Shift+p exec --no-startup-id flameshot gui -c

# i3 admin keys deliberately avoid Hyprland's SUPER+SHIFT+{r,e}, which are
# bound to webapps there.
bindsym $mod+Shift+c reload
bindsym $mod+Ctrl+r restart
bindsym $mod+Ctrl+e exec "i3-nagbar -t warning -m 'Exit i3?' -b 'Yes' 'i3-msg exit'"

# Hyprland's SUPER+C/V/X universal clipboard uses send_shortcut, which has no
# i3 equivalent without xdotool remapping - left out on purpose.

# ------------------------------------------------------------------
# Media keys
# ------------------------------------------------------------------
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume 0 +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume 0 -5%
bindsym XF86AudioMute        exec --no-startup-id pactl set-sink-mute 0 toggle
bindsym XF86MonBrightnessUp   exec --no-startup-id xbacklight -inc 20
bindsym XF86MonBrightnessDown exec --no-startup-id xbacklight -dec 20

bar {
        status_command i3status
        tray_output primary
}

exec --no-startup-id nm-applet

# A polkit authentication agent. GNOME's session starts one; a bare i3 session
# does not, so anything needing admin authorisation - wlctl deleting a saved
# profile, for instance - fails with no dialog and no visible reason, the same
# way the VPN password did. Which binary that is depends on the distro: Fedora
# retired polkit-gnome and runs/i3 installs mate-polkit there, Ubuntu still has
# polkit-gnome under /usr/lib. Try each and exec the first that exists.
exec --no-startup-id sh -c 'for a in /usr/libexec/polkit-mate-authentication-agent-1 /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 /usr/libexec/polkit-gnome-authentication-agent-1; do [ -x "$a" ] && exec "$a"; done'

