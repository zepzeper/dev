#!/usr/bin/env bash
# ~/.config/i3/monitor
set -euo pipefail

INTERNAL="eDP-1"

LID_STATE_FILE=$(echo /proc/acpi/button/lid/*/state 2>/dev/null | awk '{print $1}')

get_lid_state() {
    [ -r "$LID_STATE_FILE" ] && awk '{print $2}' "$LID_STATE_FILE" || echo "open"
}

external_output() {
    xrandr --query |
        awk -v internal="$INTERNAL" '$2=="connected" && $1!=internal {print $1; exit}'
}

preferred_mode() {
    local output="$1"
    xrandr --query |
        awk -v out="$output" '
            $0 ~ "^"out" " {found=1; next}
            found && /^[A-Za-z]/ {exit}
            found && /\+/ {print $1; exit}
        '
}

# Explicitly turn off any output xrandr lists as connected=false but still
# carrying a live mode/position (i.e. active in X even though physically
# disconnected) — this is what left i3 thinking DP-1 was alive after it
# actually dropped.
turn_off_stale_outputs() {
    xrandr --query | awk '/ disconnected /{print $1}' | while read -r out; do
        [ "$out" = "$INTERNAL" ] && continue
        xrandr --output "$out" --off 2>/dev/null || true
    done
}

LID="$(get_lid_state)"
EXT="$(external_output || true)"

turn_off_stale_outputs "$EXT"

if [ -n "$EXT" ] && [ "$LID" = "closed" ]; then
    MODE="$(preferred_mode "$EXT")"
    xrandr --output "$INTERNAL" --off --output "$EXT" --mode "${MODE:-3840x2160}" --primary
elif [ -n "$EXT" ]; then
    MODE="$(preferred_mode "$EXT")"
    xrandr --output "$INTERNAL" --auto --primary \
        --output "$EXT" --mode "${MODE:-3840x2160}" --right-of "$INTERNAL"
else
    xrandr --output "$INTERNAL" --auto --primary
fi
