#!/usr/bin/env bash
# ~/.config/i3/monitor
# Applies display layout based on lid state + whatever external output is
# actually connected right now (handles both the desk dock's DP-1 and the
# work USB-C dock, which may enumerate under a different name entirely).
set -euo pipefail

INTERNAL="eDP-1"

LID_STATE_FILE=$(echo /proc/acpi/button/lid/*/state 2>/dev/null | awk '{print $1}')

get_lid_state() {
    [ -r "$LID_STATE_FILE" ] && awk '{print $2}' "$LID_STATE_FILE" || echo "open"
}

# First connected output that isn't the internal panel. If your work dock ever
# exposes more than one live external head at once, this only picks the
# first — extend the loop below if you need multi-external support.
external_output() {
    xrandr --query |
        awk -v internal="$INTERNAL" '$2=="connected" && $1!=internal {print $1; exit}'
}

# Best available mode for a given output (xrandr marks the preferred one
# with a trailing "+"). Falls back to the first listed mode if none is
# flagged preferred.
preferred_mode() {
    local output="$1"
    xrandr --query |
        awk -v out="$output" '
            $0 ~ "^"out" " {found=1; next}
            found && /^[A-Za-z]/ {exit}
            found && /\+/ {print $1; exit}
        '
}

LID="$(get_lid_state)"
EXT="$(external_output || true)"

if [ -n "$EXT" ] && [ "$LID" = "closed" ]; then
    MODE="$(preferred_mode "$EXT")"
    xrandr --output "$INTERNAL" --off --output "$EXT" --mode "${MODE:-3840x2160}" --primary
elif [ -n "$EXT" ]; then
    MODE="$(preferred_mode "$EXT")"
    xrandr --output "$INTERNAL" --auto --primary \
        --output "$EXT" --mode "${MODE:-3840x2160}" --right-of "$INTERNAL"
else
    xrandr --output "$INTERNAL" --auto --primary
fi
