#!/usr/bin/env bash
# ~/.config/i3/monitor-watch
set -euo pipefail

LOCKFILE="/tmp/i3-monitor-watch.lock"
LOGFILE="/tmp/i3-monitor-watch.log"
exec 200>"$LOCKFILE"
if ! flock -n 200; then
    exit 0
fi

echo "$(date): watcher started" >>"$LOGFILE"

dbus-monitor --system \
    "type='signal',interface='org.freedesktop.DBus.Properties',path='/org/freedesktop/login1'" |
    while read -r line; do
        if echo "$line" | grep -q "LidClosed"; then
            echo "$(date): saw LidClosed line: $line" >>"$LOGFILE"
            sleep 0.3
            ~/.config/i3/monitor
            echo "$(date): ran monitor, exit=$?" >>"$LOGFILE"
        fi
    done
