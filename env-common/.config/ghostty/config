# Font
# Repeated font-family entries form a per-codepoint fallback chain.
# Iosevka Term has no Nerd Font glyphs, so JetBrainsMono NF backs it up for
# icons/powerline symbols in TUIs. Order matters: primary first.
font-family = "Iosevka Term"
font-style = Regular
font-size = 24

window-padding-y = 14, 0

#theme = Rose Pine Moon
#background = 161521 
background = 131519 
confirm-close-surface=false
#theme = Nord Wave
#theme = Gruvbox 
background-opacity = 0.95
confirm-close-surface=false

gtk-titlebar = false
window-decoration = none

# window-padding-x = 10
# window-padding-y = 5

# Disable Ctrl+Enter fullscreen keybind
keybind = ctrl+enter=unbind
keybind = ctrl+shift+equal=increase_font_size:1
keybind = ctrl+shift+minus=decrease_font_size:1
keybind = ctrl+shift+0=reset_font_size
