# XDG_CONFIG_HOME and ZDOTDIR are set in ~/.zshenv, which zsh reads first.
VIM="nvim"

PERSONAL=$XDG_CONFIG_HOME/personal
# -type f: find also emits $PERSONAL itself, and `source <a directory>` threw
# an error on every single shell start.
for i in $(find -L "$PERSONAL" -type f); do
    source "$i"
done

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# GOPATH, EDITOR, PATH and friends now live in ~/.config/personal/env, which
# the loop above sources - so bash and zsh cannot drift apart again.

# thanks gt
alias gt='NODE_OPTIONS="--no-deprecation" gt'

