#!/usr/bin/env bash

# LAUNCH MENU
# Main menu launcher that calls specific menu functions
# Usage: launch-menu <menu_name>

# rofi rather than walker: rofi 2.0 speaks Wayland natively and is packaged,
# where walker v2 is a from-source Rust build that additionally needs the
# elephant daemon running before it returns anything. rofi also works on X11,
# so this script is no longer Wayland-bound.
show_menu() {
    local prompt="$1"
    local options="$2"

    echo -e "$options" | rofi -dmenu -p "$prompt"
}

show_localsend_menu() {
    # localsend_app is the real binary name from upstream's tarball, and is
    # what the hypr window rule matches on.
    localsend_app
}

show_apps_menu() {
    # Build a simple list first
    app_list=$(for dir in /run/current-system/sw/share/applications /usr/share/applications ~/.local/share/applications; do
        [ ! -d "$dir" ] && continue
        for desktop_file in "$dir"/*.desktop; do
            [ ! -f "$desktop_file" ] && continue
            basename "$desktop_file" .desktop
        done
    done | sort -u)
    
    # Show the menu
    selected=$(echo "$app_list" | rofi -dmenu -p "Launch App")
    
    # Launch if something was selected
    if [ -n "$selected" ]; then
        gtk-launch "$selected.desktop" &
    fi
}

case "${1,,}" in
    localsend)
        show_localsend_menu
        ;;
    apps)
        show_apps_menu
        ;;
    *)
        echo "Usage: launch-menu <menu_name>"
        echo ""
        echo "Available menus:"
        echo "  localsend    - LocalSend share options"
        echo "  apps         - Launch applications"
        echo ""
        exit 1
        ;;
esac
