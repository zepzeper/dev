#!/usr/bin/env bash
# Commit and push whatever changed across the dev env.
#
# nvim and tmux-sessionizer are submodules, so they have to be committed and
# pushed *before* the superproject - otherwise the pointer this repo records
# refers to a commit that only exists on this machine.

set -uo pipefail

DEV_ENV_HOME="${DEV_ENV_HOME:-$HOME/personal/dev}"
MESSAGE="${1:-automated dev commit}"

commit_repo() {
    local path="$1"
    local label="$2"

    [[ -d "$path" ]] || {
        echo "skip $label: $path missing"
        return 0
    }

    if [[ -z "$(git -C "$path" status --porcelain)" ]]; then
        echo "skip $label: clean"
    else
        echo "==> $label"
        git -C "$path" add -A
        git -C "$path" commit -m "$MESSAGE"
    fi

    # Pushing even when clean is deliberate - a previous run may have committed
    # without pushing - but counting unpushed commits keeps that safety net
    # without firing a doomed push at a vendored submodule nobody here can
    # write to.
    local ahead
    ahead="$(git -C "$path" rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)"

    if ((ahead == 0)); then
        echo "skip push $label: nothing to push"
    elif git -C "$path" remote get-url origin >/dev/null 2>&1; then
        git -C "$path" push
    else
        echo "skip push $label: no origin"
    fi
}

# The nvim path used to be spelled out here, and drifted silently the moment
# the package was renamed env/ -> env-common/: commit_repo skipped it as
# "missing" on every run, while the superproject below still committed and
# pushed the new gitlink. That is how master ended up recording a submodule
# commit that had never left the machine it was authored on, breaking `git
# pull` everywhere else with "upload-pack: not our ref". Read the paths out of
# .gitmodules so a rename cannot desync them again.
while IFS= read -r path; do
    commit_repo "$DEV_ENV_HOME/$path" "$path (submodule)"
done < <(
    git -C "$DEV_ENV_HOME" config -f .gitmodules --get-regexp '^submodule\..*\.path$' |
        awk '{ print $2 }'
)

commit_repo "$DEV_ENV_HOME" "dev"
