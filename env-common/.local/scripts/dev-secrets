#!/usr/bin/env bash
# Encrypted secrets that travel with the repo.
#
# Everything is encrypted to a single age identity. That identity is itself
# encrypted with a passphrase and committed, so a new machine needs exactly one
# thing that is not in the repo: the passphrase. Keep it in Bitwarden.
#
# Consequence of the one-identity design: adding a secret needs only the public
# recipient, so `add` never prompts. Only reading needs the passphrase.
#
# Plaintext is only ever written to a tmpfs (XDG_RUNTIME_DIR or /dev/shm) and
# removed on exit, so it never touches the disk.

set -euo pipefail
umask 077

DEV_ENV_HOME="${DEV_ENV_HOME:-$HOME/personal/dev}"
SECRETS_DIR="$DEV_ENV_HOME/secrets"
STORE="$SECRETS_DIR/store"
IDENTITY_ENC="$SECRETS_DIR/identity.age"
RECIPIENT_FILE="$SECRETS_DIR/recipient.txt"
MANIFEST="$SECRETS_DIR/MANIFEST"

source "$DEV_ENV_HOME/lib/ui.sh"

need_age() {
    command -v age >/dev/null || die "age not installed - run: dev-env age"
}

# Plaintext must never land on a spinning disk or SSD where it can be
# recovered. XDG_RUNTIME_DIR is a 0700 tmpfs on systemd machines.
secure_tmpdir() {
    local base="${XDG_RUNTIME_DIR:-}"

    if [[ -z "$base" || ! -d "$base" ]]; then
        base="/dev/shm"
    fi

    [[ -d "$base" ]] || die "no tmpfs available for plaintext (tried XDG_RUNTIME_DIR, /dev/shm)"

    mktemp -d "$base/dev-secrets.XXXXXXXX"
}

TMPDIR_SECURE=""
IDENTITY_FILE=""

cleanup() {
    [[ -n "$TMPDIR_SECURE" && -d "$TMPDIR_SECURE" ]] && rm -rf "$TMPDIR_SECURE"
    return 0
}
trap cleanup EXIT INT TERM

ensure_tmpdir() {
    [[ -n "$TMPDIR_SECURE" ]] && return 0
    TMPDIR_SECURE="$(secure_tmpdir)"
}

# Decrypts the identity into the tmpfs and sets IDENTITY_FILE. Prompts for the
# passphrase once; every secret is then decrypted with it, no further prompts.
#
# This assigns a global rather than echoing the path, because a caller writing
# id="$(unlock_identity)" would run it in a subshell - TMPDIR_SECURE would be
# set only there, the parent's EXIT trap would see nothing, and the decrypted
# identity would be left behind on the tmpfs.
unlock_identity() {
    [[ -f "$IDENTITY_ENC" ]] || die "no identity - run: dev-secrets init"

    ensure_tmpdir
    IDENTITY_FILE="$TMPDIR_SECURE/identity"

    [[ -f "$IDENTITY_FILE" ]] && return 0

    age --decrypt --output "$IDENTITY_FILE" "$IDENTITY_ENC" ||
        die "could not decrypt the identity (wrong passphrase?)"

    chmod 600 "$IDENTITY_FILE"
}

# unlock restores a private key, but ssh and several tools also want the .pub
# next to it. It is derivable, so there is no reason to store it.
#
# ssh-keygen -y doubles as the test for "is this actually an ssh private key" -
# it fails on anything else. </dev/null makes a passphrase-protected key fail
# fast rather than sitting on a prompt in the middle of an unlock.
maybe_write_pubkey() {
    local target="$1"

    [[ "$target" == *.pub ]] && return 0
    command -v ssh-keygen >/dev/null || return 0

    local pub
    if pub="$(ssh-keygen -y -f "$target" 2>/dev/null </dev/null)"; then
        printf '%s\n' "$pub" >"$target.pub"
        chmod 644 "$target.pub"
        echo "    + $(basename "$target").pub"
    elif [[ "$(dirname "$target")" == "$HOME/.ssh" ]]; then
        warn "could not derive $(basename "$target").pub - passphrase-protected key?"
    fi

    return 0
}

# Emit manifest rows, skipping comments and blanks, optionally filtered to the
# names given. unlock, verify and list each had their own copy of this loop,
# and two of them repeated the name-filter block verbatim.
manifest_rows() {
    local name dest mode a wanted
    while read -r name dest mode; do
        [[ -z "$name" || "$name" == \#* ]] && continue

        if (($# > 0)); then
            wanted=0
            for a in "$@"; do [[ "$a" == "$name" ]] && wanted=1; done
            ((wanted)) || continue
        fi

        printf '%s %s %s\n' "$name" "$dest" "$mode"
    done <"$MANIFEST"
}

manifest_lookup() {
    local name="$1"
    awk -v n="$name" '$1 == n { print; exit }' "$MANIFEST" 2>/dev/null
}

expand_dest() {
    # MANIFEST stores ~ literally so it stays portable across usernames.
    local d="$1"
    printf '%s' "${d/#\~/$HOME}"
}

cmd_init() {
    need_age

    [[ -f "$IDENTITY_ENC" ]] && die "identity already exists at $IDENTITY_ENC"

    mkdir -p "$STORE"
    ensure_tmpdir

    local id="$TMPDIR_SECURE/identity"
    age-keygen -o "$id" 2>/dev/null

    age-keygen -y "$id" >"$RECIPIENT_FILE"
    chmod 644 "$RECIPIENT_FILE"

    info "choose a passphrase for the identity - store it in Bitwarden"
    info "if you lose it, every secret in this repo is unrecoverable"

    age --passphrase --output "$IDENTITY_ENC" "$id" ||
        die "encryption failed"

    [[ -f "$MANIFEST" ]] || cat >"$MANIFEST" <<'EOF'
# name          destination             mode
# A destination of - means the secret has no file on disk; read it with
# `dev-secrets cat <name>`. Paths keep a literal ~ so they stay portable.
EOF

    info "identity created"
    echo "  recipient: $(cat "$RECIPIENT_FILE")"
    echo "  encrypted: ${IDENTITY_ENC/#$HOME/\~}"
}

cmd_add() {
    need_age

    local name="${1:-}" src="${2:-}" dest="${3:--}" mode="${4:-600}"

    [[ -n "$name" && -n "$src" ]] ||
        die "usage: dev-secrets add <name> <file> [destination] [mode]"
    [[ -f "$src" ]] || die "no such file: $src"
    [[ -f "$RECIPIENT_FILE" ]] || die "no identity - run: dev-secrets init"
    [[ -n "$(manifest_lookup "$name")" ]] && die "secret already exists: $name"

    mkdir -p "$STORE"
    age --encrypt --recipient "$(cat "$RECIPIENT_FILE")" \
        --output "$STORE/$name.age" "$src"
    chmod 644 "$STORE/$name.age"

    printf '%-15s %-23s %s\n' "$name" "$dest" "$mode" >>"$MANIFEST"

    info "added $name"
    [[ "$dest" == "-" ]] &&
        echo "  no destination; read it with: dev-secrets cat $name" ||
        echo "  unlocks to $dest (mode $mode)"

    # Only nag about the source when it is a scratch copy. Importing a file
    # from the very place it is meant to live - an ssh key, say - is the normal
    # case, and telling you to delete it there would destroy the working key.
    local src_real dest_real
    src_real="$(readlink -f "$src" 2>/dev/null || printf '%s' "$src")"
    dest_real="$(expand_dest "$dest")"

    if [[ "$dest" != "-" && "$src_real" == "$dest_real" ]]; then
        echo "  source is already the destination - nothing to clean up"
    else
        warn "the plaintext at $src is still there - remove it when you are done"
    fi
}

cmd_unlock() {
    need_age

    unlock_identity

    local name dest mode count=0

    while read -r name dest mode; do
        [[ "$dest" == "-" ]] && continue

        [[ -f "$STORE/$name.age" ]] || {
            warn "in MANIFEST but missing from the store: $name"
            continue
        }

        local target
        target="$(expand_dest "$dest")"
        mkdir -p "$(dirname "$target")"

        # ~/.ssh is rejected by ssh itself if it is group/world readable.
        [[ "$(dirname "$target")" == "$HOME/.ssh" ]] && chmod 700 "$HOME/.ssh"

        age --decrypt --identity "$IDENTITY_FILE" --output "$target.tmp" "$STORE/$name.age" ||
            die "could not decrypt $name"

        chmod "$mode" "$target.tmp"
        mv "$target.tmp" "$target"

        echo "  $name -> ${target/#$HOME/\~} (mode $mode)"
        maybe_write_pubkey "$target"
        count=$((count + 1))
    done < <(manifest_rows "$@")

    info "unlocked $count secret(s)"
}

cmd_cat() {
    need_age

    local name="${1:-}"
    [[ -n "$name" ]] || die "usage: dev-secrets cat <name>"
    [[ -f "$STORE/$name.age" ]] || die "no such secret: $name"

    unlock_identity
    age --decrypt --identity "$IDENTITY_FILE" "$STORE/$name.age"
}

cmd_edit() {
    need_age

    local name="${1:-}"
    [[ -n "$name" ]] || die "usage: dev-secrets edit <name>"
    [[ -f "$STORE/$name.age" ]] || die "no such secret: $name"

    unlock_identity

    local scratch="$TMPDIR_SECURE/$name"
    age --decrypt --identity "$IDENTITY_FILE" --output "$scratch" "$STORE/$name.age"

    "${EDITOR:-nvim}" "$scratch"

    age --encrypt --recipient "$(cat "$RECIPIENT_FILE")" \
        --output "$STORE/$name.age" "$scratch"
    chmod 644 "$STORE/$name.age"

    info "re-encrypted $name"
}

# Compares each stored secret against the file it unlocks to. Catches a store
# that has drifted from disk, a destination someone edited in place, and a
# secret that no longer decrypts at all.
cmd_verify() {
    need_age
    unlock_identity

    local name dest mode problems=0 checked=0 scratch target

    while read -r name dest mode; do
        checked=$((checked + 1))

        if [[ ! -f "$STORE/$name.age" ]]; then
            printf '  %-15s MISSING from the store\n' "$name"
            problems=$((problems + 1))
            continue
        fi

        scratch="$TMPDIR_SECURE/verify.$name"
        if ! age --decrypt --identity "$IDENTITY_FILE" \
            --output "$scratch" "$STORE/$name.age" 2>/dev/null; then
            printf '  %-15s DOES NOT DECRYPT\n' "$name"
            problems=$((problems + 1))
            continue
        fi

        if [[ "$dest" == "-" ]]; then
            printf '  %-15s ok (decrypts; no destination)\n' "$name"
            rm -f "$scratch"
            continue
        fi

        target="$(expand_dest "$dest")"

        if [[ ! -e "$target" ]]; then
            printf '  %-15s not unlocked yet (%s absent)\n' "$name" "$dest"
        elif cmp -s "$scratch" "$target"; then
            # cmp -s, never diff: a mismatch must not print key material.
            printf '  %-15s ok (matches %s)\n' "$name" "$dest"
        else
            printf '  %-15s DIFFERS from %s\n' "$name" "$dest"
            problems=$((problems + 1))
        fi

        rm -f "$scratch"
    done < <(manifest_rows "$@")

    if ((problems)); then
        printf '\n\033[1;31m%d of %d failed\033[0m\n' "$problems" "$checked"
        return 1
    fi

    printf '\n\033[1;32mall %d verified\033[0m\n' "$checked"
    return 0
}

cmd_list() {
    [[ -f "$MANIFEST" ]] || die "no manifest - run: dev-secrets init"

    printf '%-15s %-23s %-6s %s\n' NAME DESTINATION MODE STORED
    local name dest mode
    while read -r name dest mode; do
        printf '%-15s %-23s %-6s %s\n' "$name" "$dest" "$mode" \
            "$([[ -f "$STORE/$name.age" ]] && echo yes || echo MISSING)"
    done < <(manifest_rows)
}

cmd_rm() {
    local name="${1:-}"
    [[ -n "$name" ]] || die "usage: dev-secrets rm <name>"
    [[ -n "$(manifest_lookup "$name")" ]] || die "no such secret: $name"

    rm -f "$STORE/$name.age"
    # Braces required: "$name[" reads as an array expansion, so this
    # never matched and rm left the manifest row behind.
    grep -v "^${name}[[:space:]]" "$MANIFEST" >"$MANIFEST.tmp"
    mv "$MANIFEST.tmp" "$MANIFEST"

    info "removed $name from the store"
    warn "the ciphertext stays in git history - rotate the secret itself"
}

usage() {
    cat <<'EOF'
dev-secrets - encrypted secrets stored in the dev repo

usage: dev-secrets <command>

  init                              create the age identity (once, ever)
  add <name> <file> [dest] [mode]   encrypt a file into the store
  unlock [name...]                  decrypt secrets to their destinations
  cat <name>                        print a secret to stdout
  edit <name>                       decrypt, edit, re-encrypt
  verify [name...]                  check the store against what is on disk
  list                              show the manifest
  rm <name>                         remove from the store

The passphrase is asked for once per command that reads secrets. Keep it in
Bitwarden - losing it makes every secret here unrecoverable.
EOF
}

main() {
    local cmd="${1:-}"
    shift || true

    case "$cmd" in
        init) cmd_init "$@" ;;
        add) cmd_add "$@" ;;
        unlock) cmd_unlock "$@" ;;
        cat) cmd_cat "$@" ;;
        edit) cmd_edit "$@" ;;
        verify) cmd_verify "$@" ;;
        list) cmd_list "$@" ;;
        rm) cmd_rm "$@" ;;
        "" | -h | --help | help) usage ;;
        *) die "unknown command: $cmd (try --help)" ;;
    esac
}

main "$@"
