#!/usr/bin/env bash

# Launch or focus on a given command identified by the passed in window-pattern.
# Use by some default bindings, like the one for Spotify, to ensure there is only one instance of the application open.

if (($# == 0)); then
    echo "Usage: omarchy-launch-or-focus [window-pattern] [launch-command]"
    exit 1
fi

WINDOW_PATTERN="$1"
LAUNCH_COMMAND="${2:-"uwsm-app -- $WINDOW_PATTERN"}"
WINDOW_ADDRESS=$(hyprctl clients -j | jq -r --arg p "$WINDOW_PATTERN" '.[]|select((.class|test("\\b" + $p + "\\b";"i")) or (.title|test("\\b" + $p + "\\b";"i")))|.address' | head -n1)

if [[ -n $WINDOW_ADDRESS ]]; then
    # Hyprland 0.56 configures in Lua, and `hyprctl dispatch` now evaluates its
    # arguments as Lua too - the old `focuswindow address:0x...` string dies on
    # a parse error, which hyprctl reports on stderr and nothing here reads. So
    # the focus half quietly stopped working: pressing the key on an already
    # open window did nothing at all, rather than launching a duplicate.
    #
    # `hyprctl eval` runs a statement instead of an expression, which is what
    # the lookup needs: dispatchers are descriptors that hl.dispatch has to be
    # handed, and hl.dsp.focus wants the window object rather than an address,
    # so the address found above has to be resolved through hl.get_window().
    # That selector wants the `address:` prefix - a bare 0x... returns nil.
    exec hyprctl eval "
        local w = hl.get_window('address:$WINDOW_ADDRESS')
        if w then hl.dispatch(hl.dsp.focus({ window = w })) end" >/dev/null
else
    eval exec setsid $LAUNCH_COMMAND
fi
