#!/usr/bin/env bash
# Toggle the current workspace between the scrolling layout and the configured
# default one.
#
# `hyprctl keyword` is gone in Hyprland 0.56: the config is Lua, and keyword
# answers "keyword can't work with non-legacy parsers. Use eval." The rule it
# used to write is `hl.workspace_rule()`, which takes the same fields as a
# table. Each call adds a rule rather than replacing the previous one, but the
# most recent match wins, so toggling stays correct.
#
# The old version also recorded which workspaces were scrolling in
# /tmp/hypr/workspace-layouts.conf, because keyword could write config but
# never read it back. Nothing creates /tmp/hypr, so that file could never be
# written: `grep -q` on a missing file is false every time, and the toggle only
# ever went one way. `hyprctl activeworkspace -j` reports the live
# `tiledLayout`, so there is nothing left to remember and no file to go stale
# across a Hyprland restart.

set -euo pipefail

read -r id current < <(hyprctl activeworkspace -j | jq -r '"\(.id) \(.tiledLayout)"')

# The off state is whatever general:layout says, not the word "default" - a
# workspace rule wants a real layout name and silently keeps the current one
# for anything it does not recognise.
if [[ $current == "scrolling" ]]; then
    want="$(hyprctl getoption general:layout -j | jq -r '.str')"
else
    want="scrolling"
fi

hyprctl eval "hl.workspace_rule({ workspace = \"$id\", layout = \"$want\" })" >/dev/null

notify-send "Workspace $id" "Layout: $want"
