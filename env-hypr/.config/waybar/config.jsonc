{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "bottom",
  "spacing": 0,
  "height": 2,
  "modules-left": ["hyprland/workspaces", "hyprland/submap"],
  "modules-center": [],
  "modules-right": [
    "pulseaudio",
    "bluetooth",
    "network",
    "disk",
    "cpu",
    "battery",
    "clock",
    "tray"
  ],
  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{name}",
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    }
  },
  "hyprland/submap": {
    "format": "{}",
    "tooltip": false
  },
  "pulseaudio": {
    "format": "vol {volume}%",
    "format-muted": "vol mute",
    "format-bluetooth": "vol {volume}% bt",
    "on-click": "launch-audio",
    "on-click-right": "pamixer -t",
    "tooltip": false,
    "scroll-step": 5
  },
  "bluetooth": {
    "format": "bt on",
    "format-off": "bt off",
    "format-disabled": "bt off",
    "format-connected": "bt {num_connections}",
    "format-no-controller": "",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "launch-bluetooth"
  },
  "network": {
    "format-wifi": "{essid} {signalStrength}%",
    "format-ethernet": "eth",
    "format-linked": "{ifname} (no IP)",
    "format-disconnected": "down",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3
  },
  "disk": {
    "path": "/",
    "format": "/ {free}",
    "tooltip-format": "{used} used of {total} on {path}",
    "interval": 30
  },
  "cpu": {
    "interval": 5,
    "format": "load {load}",
    "on-click": "launch-or-focus-tui btop",
    "on-click-right": "alacritty"
  },
  "battery": {
    "format": "bat {capacity}%",
    "format-charging": "chr {capacity}%",
    "format-plugged": "ac {capacity}%",
    "format-full": "full",
    "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}% ({time} left)",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
    "interval": 5,
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "clock": {
    "interval": 1,
    "format": "{:%Y-%m-%d %H:%M:%S}",
    "format-alt": "{:L%A %d %B W%V}",
    "tooltip": false
  },
  "tray": {
    "icon-size": 14,
    "spacing": 8
  }
}
