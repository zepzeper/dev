#!/usr/bin/env bash
# age - the encryption behind dev-secrets.

set -euo pipefail

source "$(dirname "$0")/../lib/platform.sh"
source "$(dirname "$0")/../lib/release.sh"

if command -v age >/dev/null && command -v age-keygen >/dev/null; then
    echo "age already installed: $(age --version)"
    exit 0
fi

install_packages age || true
hash -r

if command -v age >/dev/null && command -v age-keygen >/dev/null; then
    echo "installed age $(age --version) from $PKG_MANAGER"
    exit 0
fi

# Ubuntu only picked age up in 23.04; older releases need the upstream build.
echo "age not available from $PKG_MANAGER; using the upstream release"

ARCH="$(arch_name amd64 arm64)"
URL="$(github_asset FiloSottile/age "age-.*-linux-${ARCH}\.tar\.gz\"")"

install_release age "$URL" age
ln -sfn "$HOME/.local/age/age-keygen" "$HOME/.local/bin/age-keygen"

"$HOME/.local/bin/age" --version
