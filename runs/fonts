#!/usr/bin/env bash
# Fonts the ghostty config names.
#
# Neither is packaged: Fedora's jetbrains-mono-fonts is the plain family, not
# the Nerd Font patch, and Iosevka Term is not in the archives at all. On this
# workstation both had been hand-dropped into ~/.local/share/fonts, so a fresh
# machine rendered ghostty, waybar and nvim without any glyph icons.

set -euo pipefail

FONT_DIR="$HOME/.local/share/fonts"
NERD_VERSION="v3.4.0"

mkdir -p "$FONT_DIR"

fetch_nerd_font() {
    local name="$1" marker="$2"

    # Deliberately not `fc-list | grep -q`: grep exits at the first match and
    # closes the pipe, fc-list dies of SIGPIPE, and `set -o pipefail` surfaces
    # that as 141. The test would read as "not installed" every single time and
    # re-download the fonts on every run.
    local listing
    listing="$(fc-list 2>/dev/null || true)"

    if grep -qi "$marker" <<<"$listing"; then
        echo "$name already installed"
        return 0
    fi

    echo "installing $name"

    local tmp
    tmp="$(mktemp -d)"
    # shellcheck disable=SC2064
    trap "rm -rf '$tmp'" RETURN

    curl --fail --location --progress-bar \
        "https://github.com/ryanoasis/nerd-fonts/releases/download/$NERD_VERSION/$name.tar.xz" \
        --output "$tmp/$name.tar.xz"

    mkdir -p "$FONT_DIR/$name"
    tar -xJf "$tmp/$name.tar.xz" -C "$FONT_DIR/$name"

    # The archives carry licence files that fontconfig would rather not scan.
    find "$FONT_DIR/$name" -type f ! -name '*.ttf' ! -name '*.otf' -delete
}

fetch_nerd_font JetBrainsMono "JetBrainsMono.*Nerd"
fetch_nerd_font IosevkaTerm "Iosevka Term"

fc-cache -f "$FONT_DIR" >/dev/null
echo
echo "font cache rebuilt; $(fc-list 2>/dev/null | grep -ci 'nerd') nerd-font faces available"
