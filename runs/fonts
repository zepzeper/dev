#!/usr/bin/env bash
# Fonts the ghostty config names. Neither is packaged: Fedora's
# jetbrains-mono-fonts is the plain family, not the Nerd Font patch, and
# Iosevka is not in the archives at all.

set -euo pipefail

source "$(dirname "$0")/../lib/release.sh"

FONT_DIR="$HOME/.local/share/fonts"

# Deliberately not `fc-list | grep -q`: grep exits at the first match and
# closes the pipe, fc-list dies of SIGPIPE, and pipefail surfaces that as 141.
# The test would read as "not installed" on every run.
have_family() {
    local listing
    listing="$(fc-list : family 2>/dev/null || true)"
    grep -qi "$1" <<<"$listing"
}

# The nerd-fonts IosevkaTerm build registers as "IosevkaTerm NF", NOT
# "Iosevka Term" - a different family from the one the ghostty config names, so
# ghostty never found its primary font and fell back on every launch. Upstream
# Iosevka is the build carrying the expected family name.
if have_family "Iosevka Term"; then
    echo "Iosevka Term already installed"
else
    command -v unzip >/dev/null || {
        echo "unzip is required - run: ./dev-env dev" >&2
        exit 1
    }
    echo "installing Iosevka Term (upstream)"
    extract_archive \
        "$(github_asset be5invis/Iosevka 'PkgTTF-IosevkaTerm-')" \
        "$FONT_DIR/IosevkaTerm" 0
fi

# The nerd-font patch supplies the glyph coverage Iosevka lacks; the ghostty
# config lists it as the fallback in the family chain.
if have_family "JetBrainsMono.*Nerd"; then
    echo "JetBrainsMono Nerd Font already installed"
else
    echo "installing JetBrainsMono Nerd Font"
    extract_archive \
        "$(github_asset ryanoasis/nerd-fonts 'JetBrainsMono\.tar\.xz')" \
        "$FONT_DIR/JetBrainsMono" 0
fi

find "$FONT_DIR" -type f ! -name '*.ttf' ! -name '*.otf' -delete
fc-cache -f "$FONT_DIR" >/dev/null

echo
for f in "Iosevka Term" "JetBrainsMono.*Nerd"; do
    printf '  %-24s %s faces\n' "$f" "$(fc-list : family 2>/dev/null | grep -ci "$f" || true)"
done
