#!/usr/bin/env bash
# Helium - the browser the hypr bindings and launch-webapp expect.

set -euo pipefail

source "$(dirname "$0")/../lib/platform.sh"

if command -v helium >/dev/null; then
    echo "helium already installed: $(command -v helium)"
    exit 0
fi

case "$OS" in
    fedora)
        # Packaged as helium-bin; see pkg_name() in lib/platform.sh.
        enable_copr "imput/helium"
        install_packages helium
        ;;

    ubuntu | debian)
        # Upstream ships an AppImage and a tarball, no .deb, so this lands in
        # ~/.local like odin and the nvim nightly rather than via apt.
        case "$(uname -m)" in
            x86_64) ARCH="x86_64" ;;
            aarch64 | arm64) ARCH="arm64" ;;
            *)
                echo "No helium build for $(uname -m)" >&2
                exit 1
                ;;
        esac

        URL="$(curl -fsSL https://api.github.com/repos/imputnet/helium-linux/releases/latest |
            grep '"browser_download_url":' |
            grep "${ARCH}_linux\.tar\.xz\"" |
            head -n1 |
            sed -E 's/.*"browser_download_url": "([^"]+)".*/\1/')"

        [[ -n "$URL" ]] || {
            echo "Could not resolve a helium tarball for $ARCH" >&2
            exit 1
        }

        TMP_DIR="$(mktemp -d)"
        trap 'rm -rf "$TMP_DIR"' EXIT

        echo "downloading $(basename "$URL")"
        curl --fail --location --progress-bar "$URL" --output "$TMP_DIR/helium.tar.xz"
        tar -xJf "$TMP_DIR/helium.tar.xz" -C "$TMP_DIR"

        SRC="$(find "$TMP_DIR" -mindepth 1 -maxdepth 1 -type d | head -n1)"
        [[ -n "$SRC" ]] || {
            echo "unexpected archive layout" >&2
            exit 1
        }

        rm -rf "$HOME/.local/helium"
        mkdir -p "$HOME/.local/bin"
        mv "$SRC" "$HOME/.local/helium"

        # Link the launcher, not the raw `chrome` binary next to it: the
        # wrapper sets up the profile dir and flags Chromium forks expect.
        for entry in helium-wrapper helium chrome; do
            [[ -x "$HOME/.local/helium/$entry" ]] || continue
            ln -sfn "$HOME/.local/helium/$entry" "$HOME/.local/bin/helium"
            break
        done

        # Without a .desktop entry xdg-open has no browser to hand a URL to, so
        # every webapp binding silently does nothing - xdg-settings reports an
        # empty default. The shipped file points Exec at an install prefix we
        # are not using, so rewrite it.
        DESKTOP_SRC="$HOME/.local/helium/helium.desktop"
        DESKTOP_DIR="$HOME/.local/share/applications"

        if [[ -f "$DESKTOP_SRC" ]]; then
            mkdir -p "$DESKTOP_DIR"
            sed -E "s|^Exec=[^ ]*|Exec=$HOME/.local/bin/helium|; s|^Icon=.*|Icon=$HOME/.local/helium/product_logo_256.png|" \
                "$DESKTOP_SRC" >"$DESKTOP_DIR/helium.desktop"

            command -v update-desktop-database >/dev/null &&
                update-desktop-database "$DESKTOP_DIR" 2>/dev/null

            xdg-settings set default-web-browser helium.desktop 2>/dev/null ||
                xdg-mime default helium.desktop x-scheme-handler/http x-scheme-handler/https 2>/dev/null || true

            echo "installed helium.desktop and set it as the default browser"
        else
            echo "warning: no helium.desktop in the tarball; xdg-open will not find it" >&2
        fi
        ;;
esac

command -v helium >/dev/null && echo "installed: $(command -v helium)"
true
