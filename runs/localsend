#!/usr/bin/env bash
# LocalSend, from upstream's release tarball.
#
# The binary is named localsend_app, which is what the hypr window rule in
# apps/localsend.lua matches on and what launch-menu invokes.

set -euo pipefail

source "$(dirname "$0")/../lib/release.sh"

have localsend_app && exit 0

ARCH="$(arch_name x86-64 arm-64)"

# Not github_asset: the newest tag (v1.18.1) ships android apks only, so
# releases/latest matches nothing and the install would silently fail.
URL="$(github_asset_scan localsend/localsend "LocalSend-.*-linux-${ARCH}\.tar\.gz")"

install_release localsend "$URL" localsend_app

# Desktop entry so it shows up in launch-menu's app list and xdg-open handoffs.
DESKTOP="$HOME/.local/share/applications/localsend.desktop"
mkdir -p "$(dirname "$DESKTOP")"
cat >"$DESKTOP" <<EOF
[Desktop Entry]
Type=Application
Name=LocalSend
Comment=Share files to nearby devices
Exec=$HOME/.local/bin/localsend_app
Icon=$HOME/.local/localsend/data/flutter_assets/assets/img/logo-512.png
Terminal=false
Categories=Network;FileTransfer;
StartupWMClass=localsend_app
EOF

command -v update-desktop-database >/dev/null &&
    update-desktop-database "$(dirname "$DESKTOP")" 2>/dev/null

echo "installed localsend_app"
