#!/usr/bin/env bash
# The Odin compiler - not packaged by either distro.

set -euo pipefail

source "$(dirname "$0")/../lib/release.sh"

have odin && exit 0

ARCH="$(arch_name amd64 arm64)"
URL="$(github_asset odin-lang/Odin "odin-linux-${ARCH}.*\.tar\.gz\"")"

install_release odin "$URL" odin

"$HOME/.local/bin/odin" version
