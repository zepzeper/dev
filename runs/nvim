#!/usr/bin/env bash
# Neovim. The config tracks nightly features, so this deliberately installs
# nightly rather than the distro's stable build.

set -euo pipefail

source "$(dirname "$0")/../lib/platform.sh"
source "$(dirname "$0")/../lib/release.sh"

DEV_ENV_HOME="$(cd "$(dirname "$0")/.." && pwd)"
NVIM_SM="env-common/.config/nvim"

install_nvim() {
    case "$OS" in
        fedora)
            enable_copr "agriffis/neovim-nightly"
            install_packages neovim
            return
            ;;
    esac

    # Ubuntu's neovim is far too old for this config and the PPA lags too.
    # Never `nvim --version | head -1 | grep -q`: head closes the pipe, nvim
    # dies of SIGPIPE and pipefail reports 141, so the check always fails.
    if command -v nvim >/dev/null; then
        local version
        version="$(nvim --version 2>/dev/null | head -1 || true)"
        if grep -qE 'v0\.(1[1-9]|[2-9][0-9])' <<<"$version"; then
            echo "nvim already recent enough: $version"
            return
        fi
    fi

    install_release nvim \
        "https://github.com/neovim/neovim/releases/download/nightly/nvim-linux-$(arch_name x86_64 arm64).tar.gz" \
        bin/nvim
}

install_nvim

# The config lives in a submodule. A plain `git clone` - the https bootstrap,
# and dev-vm's cloud-init - leaves it empty, and stow then links nothing, so
# nvim starts with no configuration at all.
#
# The submodule url is ssh so it stays pushable, but a machine that has not run
# `dev-secrets unlock` has no key. Fall back to https for a read-only checkout;
# `git remote set-url` inside the submodule restores push access.
if [[ -z "$(ls -A "$DEV_ENV_HOME/$NVIM_SM" 2>/dev/null)" ]]; then
    echo "nvim config submodule is empty; checking it out"

    if ! git -C "$DEV_ENV_HOME" submodule update --init "$NVIM_SM" 2>/dev/null; then
        echo "  ssh failed (no key yet?) - retrying over https"
        # A url rewrite rather than -c submodule.<path>.url: submodule update
        # copies the url into .git/config on the first attempt, so the
        # per-submodule override is ignored once that has happened.
        git -C "$DEV_ENV_HOME" \
            -c "url.https://github.com/.insteadOf=git@github.com:" \
            submodule update --init "$NVIM_SM"
    fi

    echo "  re-linking so stow picks up the new files"
    "$DEV_ENV_HOME/dev-env" link >/dev/null
fi

if [[ -x "$HOME/.local/bin/nvim" ]]; then
    "$HOME/.local/bin/nvim" --version | head -1
elif command -v nvim >/dev/null; then
    nvim --version | head -1
fi
true
