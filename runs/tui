#!/usr/bin/env bash
# The TUIs and launcher the hypr bindings open. None are packaged by Fedora or
# Ubuntu, so they come from crates.io and upstream releases.

set -euo pipefail

source "$(dirname "$0")/../lib/platform.sh"
source "$(dirname "$0")/../lib/ui.sh"

# rustup installs here; the invoking shell may well not have it on PATH yet.
[[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"

need cargo rust

# bluetui links libdbus (it drives BlueZ over D-Bus), so the headers and
# pkg-config must be present before cargo builds it. This never showed up on
# Fedora because bluetui was already installed there and never rebuilt.
#
# wiremix is the same story against PipeWire: pipewire-sys generates its
# bindings with bindgen, so libclang has to be there too, not just the headers.
install_packages dbus-devel pkg-config pipewire-devel clang-devel

# Both come from crates.io; --locked keeps a broken upstream dependency bump
# from taking the build down.
#
# wiremix was missing here even though the hypr launch-audio has always called
# it - it had been installed by hand on the workstation, so a fresh machine got
# an audio binding that opened a terminal and immediately closed it.
install_crate() {
    local crate="$1"
    local for_what="$2"

    if command -v "$crate" >/dev/null; then
        echo "$crate already installed: $(command -v "$crate")"
    else
        echo "installing $crate from crates.io ($for_what)"
        cargo install --locked "$crate"
    fi
}

install_crate bluetui launch-bluetooth
install_crate wiremix launch-audio

# wlctl is impala's UX rebuilt on NetworkManager. impala itself is what Omarchy
# uses and is the obvious pick, but it drives iwd - no use on a machine whose
# wifi and OpenVPN profile both live in NetworkManager, and iwd cannot do the
# 802.1X a work network may want. wlctl drives wifi and WireGuard; it defers
# OpenVPN activation to nmcli, which is what launch-vpn is for.
install_crate wlctl launch-wifi

echo
echo "done - launch-bluetooth, launch-audio and launch-wifi resolve"
