#!/usr/bin/env bash
# The TUIs and launcher the hypr bindings open. None are packaged by Fedora or
# Ubuntu, so they come from crates.io and upstream releases.

set -euo pipefail

source "$(dirname "$0")/../lib/platform.sh"

need() {
    command -v "$1" >/dev/null || {
        echo "$1 is required for this installer - run: ./dev-env $2" >&2
        exit 1
    }
}

need cargo rust

# launch-wifi (impala) and launch-bluetooth (bluetui). Both are genuine
# crates.io packages; --locked keeps a broken upstream dependency bump from
# taking the build down.
for crate in impala bluetui; do
    if command -v "$crate" >/dev/null; then
        echo "$crate already installed: $(command -v "$crate")"
    else
        echo "installing $crate from crates.io"
        cargo install --locked "$crate"
    fi
done

echo
echo "done - launch-wifi and launch-bluetooth resolve"
