#!/usr/bin/env bash
# The TUIs and launcher the hypr bindings open. None are packaged by Fedora or
# Ubuntu, so they come from crates.io and upstream releases.

set -euo pipefail

source "$(dirname "$0")/../lib/platform.sh"

need() {
    command -v "$1" >/dev/null || {
        echo "$1 is required for this installer - run: ./dev-env $2" >&2
        exit 1
    }
}

need cargo rust

# launch-wifi (impala) and launch-bluetooth (bluetui). Both are genuine
# crates.io packages; --locked keeps a broken upstream dependency bump from
# taking the build down.
for crate in impala bluetui; do
    if command -v "$crate" >/dev/null; then
        echo "$crate already installed: $(command -v "$crate")"
    else
        echo "installing $crate from crates.io"
        cargo install --locked "$crate"
    fi
done

# launch-menu's dmenu. Note this is abenz1267/walker, the Wayland launcher -
# the "walker" crate on crates.io is an unrelated directory-walking library, so
# cargo install walker would silently give you the wrong thing.
if command -v walker >/dev/null; then
    echo "walker already installed: $(command -v walker)"
elif command -v go >/dev/null; then
    echo "installing walker (abenz1267/walker) via go"
    GOPATH="${GOPATH:-$HOME/.local/go}" go install github.com/abenz1267/walker@latest
else
    echo "walker needs go - run ./dev-env dev first" >&2
fi

echo
echo "done - launch-wifi, launch-bluetooth and launch-menu should resolve now"
