#!/usr/bin/env bash
# The TUIs and launcher the hypr bindings open. None are packaged by Fedora or
# Ubuntu, so they come from crates.io and upstream releases.

set -euo pipefail

source "$(dirname "$0")/../lib/platform.sh"

need() {
    command -v "$1" >/dev/null || {
        echo "$1 is required for this installer - run: ./dev-env $2" >&2
        exit 1
    }
}

need cargo rust

# launch-wifi (impala) and launch-bluetooth (bluetui). Both are genuine
# crates.io packages; --locked keeps a broken upstream dependency bump from
# taking the build down.
for crate in impala bluetui; do
    if command -v "$crate" >/dev/null; then
        echo "$crate already installed: $(command -v "$crate")"
    else
        echo "installing $crate from crates.io"
        cargo install --locked "$crate"
    fi
done

# launch-menu's dmenu.
#
# Not `cargo install walker`: the walker crate on crates.io is an unrelated
# directory-walking library. Not `go install` either - walker was Go up to v1,
# but v2 is Rust, and the lingering +incompatible module tag makes go install
# fail with "module found, but does not contain package".
#
# v2 also is not a single binary: it needs the elephant daemon plus providers
# running before it will show anything. That is a bigger install than the rest
# of this script, so it is opt-in rather than automatic.
if command -v walker >/dev/null; then
    echo "walker already installed: $(command -v walker)"
else
    cat <<'EOF'

walker is NOT installed - launch-menu will not work.

  It is a Rust GTK4 app since v2 and needs both a build toolchain and a
  companion daemon:

    sudo dnf install -y gtk4-devel gtk4-layer-shell-devel \
        protobuf-compiler wayland-devel
    cargo install --git https://github.com/abenz1267/walker
    cargo install --git https://github.com/abenz1267/elephant

  elephant must be running before walker will return results.

  Simpler alternative: point launch-menu at a packaged launcher such as
  fuzzel --dmenu, which is a single binary with no daemon.
EOF
fi

echo
echo "done - launch-wifi, launch-bluetooth and launch-audio resolve"
