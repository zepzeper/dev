#!/usr/bin/env bash
# libvirt + KVM, for testing this repo's bootstrap without touching the host.
#
# The i3/Ubuntu profile and the copr installers cannot be exercised on the
# workstation, so a throwaway guest is the only honest way to verify them.

set -euo pipefail

source "$(dirname "$0")/../lib/platform.sh"

# Provisioning a hypervisor inside a guest is pointless: dev-vm exists to test
# this repo in a VM, and `dev-env all` would otherwise spend minutes installing
# libvirt there. Nested virt is a real use case though, so it is overridable.
if [[ "${VM_ALLOW_NESTED:-0}" != "1" ]] &&
    systemd-detect-virt --vm --quiet 2>/dev/null; then
    echo "running inside a $(systemd-detect-virt) guest - skipping libvirt"
    echo "set VM_ALLOW_NESTED=1 if you actually want nested virtualisation"
    exit 0
fi

[[ -e /dev/kvm ]] || {
    echo "No /dev/kvm - enable virtualisation in firmware first." >&2
    exit 1
}

case "$OS" in
    fedora)
        install_packages \
            qemu-kvm \
            libvirt \
            libvirt-daemon-config-network \
            virt-install \
            virt-viewer \
            edk2-ovmf \
            cloud-utils \
            genisoimage \
            openssh-clients
        ;;
    ubuntu | debian)
        install_packages \
            qemu-kvm \
            libvirt-daemon-system \
            libvirt-clients \
            virtinst \
            virt-viewer \
            ovmf \
            cloud-image-utils \
            genisoimage
        ;;
esac

sudo systemctl enable --now libvirtd

# Without group membership every virsh call needs sudo, and dev-vm assumes it
# does not. Takes effect on next login.
if ! id -nG "$USER" | grep -qw libvirt; then
    sudo usermod -aG libvirt "$USER"
    echo
    echo "Added $USER to the libvirt group - log out and back in for it to apply."
fi

# The default NAT network is what gives guests outbound access and dev-vm the
# DHCP lease it resolves guest IPs from. It ships disabled on a fresh install.
if ! sudo virsh net-info default >/dev/null 2>&1; then
    echo "no 'default' network defined - check libvirt-daemon-config-network" >&2
elif [[ "$(sudo virsh net-info default | awk '/^Active/{print $2}')" != "yes" ]]; then
    sudo virsh net-start default
    sudo virsh net-autostart default
fi

# qemu runs as its own account under qemu:///system and cannot traverse a 0700
# $HOME, so disks kept there fail with "Cannot access storage file ... (as
# uid:107)". Granting search along the chain is narrower than loosening the
# mode on $HOME, and libvirt still chowns the disk itself at start.
VM_DIR="${VM_DIR:-$HOME/.local/share/dev-vm}"
QEMU_USER="$([[ "$OS" == fedora ]] && echo qemu || echo libvirt-qemu)"

command -v setfacl >/dev/null || install_packages acl

mkdir -p "$VM_DIR/disks" "$VM_DIR/images"

echo "granting $QEMU_USER search access to $VM_DIR"
d="$VM_DIR"
while [[ "$d" != "/" && "$d" != "$(dirname "$d")" ]]; do
    sudo setfacl -m "u:$QEMU_USER:x" "$d"
    d="$(dirname "$d")"
done
sudo setfacl -R -m "u:$QEMU_USER:rx" "$VM_DIR"
# Default ACL so disks created later inherit access without re-running this.
sudo setfacl -d -m "u:$QEMU_USER:rwx" "$VM_DIR/disks"

echo
echo "libvirt ready. Create a test guest with: dev-vm create ubuntu"
