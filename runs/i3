#!/usr/bin/env bash
# The i3 session, on X11.
#
# Both machines can run it: the work laptop has nothing else, and the Fedora
# workstation keeps its Hyprland session installed alongside - which of the two
# a machine actually uses is the stow profile's business (./dev-env profile),
# not this installer's.

set -euo pipefail

source "$(dirname "$0")/../lib/platform.sh"

# Canonical names; lib/platform.sh maps the ones that differ per distro. i3 is
# the metapackage on Ubuntu and pulls i3-wm in, so naming it once is enough.
#
# A cloud image has no X server at all, so i3 would install with nothing to run
# on. xorg plus xinit lets a session start straight from a TTY, which avoids
# pulling a whole display manager into a test guest; where one is already
# installed - gdm on the workstation - it picks up i3.desktop by itself.
#
# i3lock and flameshot are bound in the i3 config ($mod+Ctrl+l, CTRL+SHIFT+P)
# but were never installed by anything, so both keys did nothing on a machine
# that had not had them added by hand.
install_packages \
    xorg \
    xinit \
    x11-xserver-utils \
    xset \
    i3 \
    i3status \
    i3lock \
    rofi \
    dmenu \
    xss-lock \
    flameshot \
    jq \
    libnotify \
    xdg-utils \
    polkit-agent

# flameshot 14 asks the freedesktop screenshot portal even on X11, and no
# portal backend can serve a screenshot in an i3 session: the gtk one delegates
# to org.gnome.Shell.Screenshot and the hyprland one needs Hyprland. So
# CTRL+SHIFT+P hung for 30 seconds and reported "Unable to capture screen".
#
# Flameshot ships the escape hatch for exactly this - its own help text names
# i3 - but only as a checkbox in its GUI, so set the key it writes. The laptop
# never needed it: Ubuntu ships flameshot 12, which captures X11 natively and
# ignores this key, so setting it on both machines is harmless.
#
# Not a stowed dotfile: flameshot rewrites this file through QSettings, which
# replaces it rather than editing in place and would leave the symlink dangling
# the first time any other setting changed.
FLAMESHOT_INI="$HOME/.config/flameshot/flameshot.ini"
FLAMESHOT_KEY="useX11LegacyScreenshot"

if [[ ! -f "$FLAMESHOT_INI" ]]; then
    mkdir -p "$(dirname "$FLAMESHOT_INI")"
    printf '[General]\n%s=true\n' "$FLAMESHOT_KEY" >"$FLAMESHOT_INI"
    echo "flameshot: created $FLAMESHOT_INI with $FLAMESHOT_KEY=true"
elif grep -q "^$FLAMESHOT_KEY=true$" "$FLAMESHOT_INI"; then
    echo "flameshot: $FLAMESHOT_KEY already true"
elif grep -q "^$FLAMESHOT_KEY=" "$FLAMESHOT_INI"; then
    sed -i "s|^$FLAMESHOT_KEY=.*|$FLAMESHOT_KEY=true|" "$FLAMESHOT_INI"
    echo "flameshot: set $FLAMESHOT_KEY=true"
elif grep -q '^\[General\]' "$FLAMESHOT_INI"; then
    # Under the existing [General], not appended to the end of the file, where
    # it would land inside whatever section happens to come last.
    sed -i "0,/^\[General\]/s||[General]\n$FLAMESHOT_KEY=true|" "$FLAMESHOT_INI"
    echo "flameshot: added $FLAMESHOT_KEY=true"
else
    printf '[General]\n%s=true\n' "$FLAMESHOT_KEY" >>"$FLAMESHOT_INI"
    echo "flameshot: added [General] $FLAMESHOT_KEY=true"
fi

# Idle locks, and only locks. xss-lock owns the idle timeout (see the i3
# config); logind carries an idle action of its own, and if that ever became a
# suspend the two would both fire - the screen locks and then the machine
# sleeps behind it, which is not what locking a screen means to anyone.
#
# "ignore" is already the built-in default, so this changes nothing today. It
# is written down because a default is not a promise: a distro upgrade or one
# stray edit to logind.conf flips it silently, and the symptom - a workstation
# that goes to sleep while you read - reads as a hardware fault rather than a
# setting. doctor asserts the live value for the same reason.
#
# This is about *idle* only. The lid drop-in below is deliberately left alone:
# closing a laptop is a deliberate act and still suspends.
sudo install -d -m 755 /etc/systemd/logind.conf.d
sudo tee /etc/systemd/logind.conf.d/20-idle.conf >/dev/null <<'IDLE'
[Login]
IdleAction=ignore
IDLE
echo "idle drop-in written: logind will not suspend on idle"

# gsd-power does not run in an i3 session, so this key bites nothing today -
# but it currently says "suspend after 15 minutes on AC", and that is what
# would take the machine down the moment anyone logs into GNOME to check
# something. The battery equivalent is left as it is: a laptop that sleeps on
# battery is behaving correctly.
if command -v gsettings >/dev/null; then
    gsettings set org.gnome.settings-daemon.plugins.power \
        sleep-inactive-ac-type nothing
    echo "gnome idle-suspend on AC: nothing"
fi

# Closing the lid at the desk must not suspend the machine. logind's "docked"
# test counts *external* connectors only - it skips eDP/LVDS - so one monitor
# plugged in is enough to select HandleLidSwitchDocked, and the bare
# HandleLidSwitch still suspends the undocked laptop on the way into a bag.
# Doing it here rather than in a dotfile because the file is root-owned and
# outside stow's reach.
#
# Guarded on the machine actually having a lid: the workstation has none, and
# writing a drop-in about a switch that does not exist is noise - doctor would
# then have to check for a file that means nothing there.
if compgen -G '/proc/acpi/button/lid/*' >/dev/null; then
    sudo install -d -m 755 /etc/systemd/logind.conf.d
    sudo tee /etc/systemd/logind.conf.d/10-lid.conf >/dev/null <<'LID'
[Login]
HandleLidSwitch=suspend
HandleLidSwitchExternalPower=suspend
HandleLidSwitchDocked=ignore
LID

    # Deliberately not restarting logind: it terminates the running session on
    # the spot. The drop-in applies at the next boot.
    echo "lid drop-in written; it takes effect after a reboot"
else
    echo "no lid on this machine; skipping the logind drop-in"
fi

echo
echo "Installed. Pin the session profile if this machine also has another:"
echo "  ./dev-env profile i3 && ./dev-env link"
