#!/usr/bin/env bash
# The i3 session for the laptop.

set -euo pipefail

source "$(dirname "$0")/../lib/platform.sh"

case "$OS" in
    ubuntu | debian)
        # i3 is the metapackage; i3-wm is the compositor alone. Installing the
        # metapackage pulls i3-wm in, so the old "try one, then the other" pair
        # of unguarded `apt install` calls was redundant - and neither was
        # checked, so a failure went unnoticed.
        # A cloud image has no X server at all, so i3 would install with nothing
        # to run on. xinit lets a session start straight from a TTY, which
        # avoids pulling a whole display manager into a test guest.
        install_packages \
            xorg \
            xinit \
            x11-xserver-utils \
            i3 \
            i3status \
            rofi \
            dmenu \
            xss-lock \
            jq \
            libnotify-bin \
            xdg-utils \
            polkit-agent

        # Closing the lid at the desk must not suspend the machine. logind's
        # "docked" test counts *external* connectors only - it skips eDP/LVDS -
        # so one monitor plugged in is enough to select HandleLidSwitchDocked,
        # and the bare HandleLidSwitch still suspends the undocked laptop on
        # the way into a bag. Doing it here rather than in a dotfile because
        # the file is root-owned and outside stow's reach.
        sudo install -d -m 755 /etc/systemd/logind.conf.d
        sudo tee /etc/systemd/logind.conf.d/10-lid.conf >/dev/null <<'LID'
[Login]
HandleLidSwitch=suspend
HandleLidSwitchExternalPower=suspend
HandleLidSwitchDocked=ignore
LID

        # Deliberately not restarting logind: it terminates the running
        # session on the spot. The drop-in applies at the next boot.
        echo "lid drop-in written; it takes effect after a reboot"
        ;;

    fedora)
        # The workstation runs Hyprland - see runs/hyprland.
        echo "i3 is not provisioned on Fedora; this machine uses Hyprland."
        exit 0
        ;;
esac
