#!/usr/bin/env bash

set -euo pipefail

source "$(dirname "$0")/../lib/platform.sh"

if command -v ghostty >/dev/null; then
    echo "ghostty already installed: $(ghostty --version 2>/dev/null | head -1)"
    exit 0
fi

case "$OS" in
    fedora)
        # Not in Fedora proper. The workstation only had it because this copr
        # had been enabled by hand, so a fresh machine got "no match" here.
        enable_copr "scottames/ghostty"
        install_packages ghostty
        ;;

    ubuntu | debian)
        # Upstream ships no .deb and building needs zig 0.16-dev, which Ubuntu
        # does not package at all - so a source build means bootstrapping a zig
        # toolchain first. These community builds track upstream releases and
        # match the version the copr gives Fedora, keeping both machines level.
        REPO="mkasberg/ghostty-ubuntu"

        case "$(dpkg --print-architecture)" in
            amd64) ARCH="amd64" ;;
            arm64) ARCH="arm64" ;;
            *)
                echo "No ghostty build for $(dpkg --print-architecture)" >&2
                exit 1
                ;;
        esac

        # Ubuntu assets are keyed by version (24.04), Debian's by codename.
        [[ "$OS" == "ubuntu" ]] && TAG="$VERSION_ID" || TAG="$VERSION_CODENAME"

        echo "looking for a ghostty build for $OS $TAG/$ARCH"

        URL="$(curl -fsSL "https://api.github.com/repos/$REPO/releases/latest" |
            grep '"browser_download_url":' |
            grep "_${ARCH}_${TAG}\.deb" |
            head -n1 |
            sed -E 's/.*"browser_download_url": "([^"]+)".*/\1/')"

        if [[ -z "$URL" ]]; then
            echo "No prebuilt ghostty for $OS $TAG/$ARCH." >&2
            echo "Build from source instead (needs zig >= 0.16):" >&2
            echo "  https://ghostty.org/docs/install/build" >&2
            exit 1
        fi

        TMP_DIR="$(mktemp -d)"
        trap 'rm -rf "$TMP_DIR"' EXIT

        echo "downloading $(basename "$URL")"
        curl --fail --location --progress-bar "$URL" \
            --output "$TMP_DIR/ghostty.deb"

        # apt-get install on a local .deb resolves its dependencies; dpkg -i
        # would leave them unconfigured.
        apt_update_once
        sudo apt-get install -y "$TMP_DIR/ghostty.deb"
        ;;
esac

command -v ghostty >/dev/null && ghostty --version | head -1
true
