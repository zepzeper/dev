#!/usr/bin/env bash
# Ansible control node, in its own venv rather than from the distro repos.
#
# Two reasons not to use install_packages here: Fedora 44 and noble ship
# different ansible majors, and the ds10u playbooks in ~/personal/ansible pin
# ansible>=14,<15 in their requirements.txt. That repo's Makefile already
# expects the interpreter at ~/ansible-env/bin, so build exactly that.

set -euo pipefail

source "$(dirname "$0")/../lib/platform.sh"

ANSIBLE_ENV="${ANSIBLE_ENV:-$HOME/ansible-env}"
ANSIBLE_REPO="${ANSIBLE_REPO:-$HOME/personal/ansible}"

# Kept in step with $ANSIBLE_REPO/requirements.txt by hand. They are duplicated
# rather than read from it so a machine without the playbooks checked out still
# gets the same versions.
#
# ansible-core rather than the `ansible` bundle: the bundle vendors ~100
# collections into site-packages, which then collide with the galaxy-installed
# ones below and with themselves through Fedora's lib64 -> lib symlink.
ANSIBLE_SPEC="${ANSIBLE_SPEC:-ansible-core>=2.21,<2.22}"
ANSIBLE_LINT_SPEC="${ANSIBLE_LINT_SPEC:-ansible-lint>=25,<27}"

install_packages python3 python3-pip python3-venv

[[ -x "$ANSIBLE_ENV/bin/python" ]] || python3 -m venv "$ANSIBLE_ENV"

"$ANSIBLE_ENV/bin/pip" install --quiet --upgrade pip

# A venv built before the switch still carries the `ansible` bundle. Installing
# ansible-core does not displace it, and while both are present every collection
# stays on the search path twice. pip reports the two distributions separately,
# so this only matches the bundle.
if "$ANSIBLE_ENV/bin/pip" show ansible >/dev/null 2>&1; then
    echo "  removing the ansible bundle (superseded by ansible-core)"
    "$ANSIBLE_ENV/bin/pip" uninstall -y ansible >/dev/null
fi
"$ANSIBLE_ENV/bin/pip" install --quiet --upgrade "$ANSIBLE_SPEC" "$ANSIBLE_LINT_SPEC"

# The playbooks declare the collections they need (community.general,
# ansible.posix). Install them when the repo is here, and skip quietly when it
# is not, so this still works on a machine that never runs them.
if [[ -f "$ANSIBLE_REPO/requirements.yml" ]]; then
    "$ANSIBLE_ENV/bin/ansible-galaxy" collection install \
        -r "$ANSIBLE_REPO/requirements.yml"
else
    echo "  skip collections ($ANSIBLE_REPO/requirements.yml not found)"
fi

# The kubernetes.core.kustomize lookup renders the k8s/ tree on the control
# node, so a kustomize (or kubectl) binary has to be here, not just on the
# server. Installed alongside ansible because it is useless without it.
KUSTOMIZE_VERSION="${KUSTOMIZE_VERSION:-5.4.3}"

if ! command -v kustomize >/dev/null; then
    echo "  installing kustomize $KUSTOMIZE_VERSION"
    tmp="$(mktemp -d)"
    curl -fsSL "https://github.com/kubernetes-sigs/kustomize/releases/download/kustomize%2Fv${KUSTOMIZE_VERSION}/kustomize_v${KUSTOMIZE_VERSION}_linux_amd64.tar.gz" |
        tar xz -C "$tmp"
    install -Dm755 "$tmp/kustomize" "$HOME/.local/bin/kustomize"
    rm -rf "$tmp"
fi

"$ANSIBLE_ENV/bin/ansible" --version | head -1
"$ANSIBLE_ENV/bin/ansible-lint" --version | head -1

# The playbooks cannot do anything without the vault password. It lives in
# dev-secrets and lands at the path scripts/get-vault-password.sh already looks
# for, so say plainly when it is missing rather than letting the first `make
# lint` fail with a wall of decryption errors.
VAULT_PASSWORD_FILE="${VAULT_PASSWORD_FILE:-$HOME/.config/ansible/krugten-vault-password}"

if [[ -f "$VAULT_PASSWORD_FILE" ]]; then
    echo "  vault password present"
else
    echo "  NOTE: no vault password at ${VAULT_PASSWORD_FILE/#$HOME/\~}"
    echo "        run: dev-secrets unlock ansible-vault"
fi
