# name          destination             mode
# A destination of - means the secret has no file on disk; read it with
# `dev-secrets cat <name>`. Paths keep a literal ~ so they stay portable.
sshkey          ~/.ssh/id_ed25519       600
intelephense    ~/intelephense/license.txt 600
ansible-vault   ~/.config/ansible/krugten-vault-password 600
tailscale-authkey ~/.config/tailscale/authkey 600
