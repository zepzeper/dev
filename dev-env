#!/usr/bin/env bash
# Bootstrap / update this machine.
#
#   ./dev-env                 print help (does not change anything)
#   ./dev-env all             link dotfiles, then run every installer
#   ./dev-env link            link dotfiles only
#   ./dev-env unlink          remove the symlinks stow created
#   ./dev-env dev docker      run only the named installers
#   ./dev-env doctor          check this machine for problems
#   ./dev-env --list          show available installers

set -euo pipefail

DEV_ENV_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNS_DIR="$DEV_ENV_HOME/runs"
PROFILE_FILE="$DEV_ENV_HOME/.dev-profile"
FORCE_LINK=0

# env-common is stowed everywhere; exactly one session profile joins it. The
# laptop runs i3 on X11 and must not receive Hyprland configs or the launchers
# that shell out to hyprctl, and the workstation has no use for i3's.
detect_profile() {
    [[ -n "${DEV_ENV_PROFILE:-}" ]] && {
        printf '%s' "$DEV_ENV_PROFILE"
        return
    }

    [[ -f "$PROFILE_FILE" ]] && {
        tr -d '[:space:]' <"$PROFILE_FILE"
        return
    }

    # Fall back to what is actually installed. On a bare machine neither is
    # present yet, so link stows common only; re-run after runs/desktop.
    command -v hyprctl >/dev/null && {
        printf 'hypr'
        return
    }
    command -v i3 >/dev/null && {
        printf 'i3'
        return
    }

    printf ''
}

active_packages() {
    local profile
    profile="$(detect_profile)"

    printf 'env-common\n'
    [[ -n "$profile" ]] && printf 'env-%s\n' "$profile"
    return 0
}

info() { printf '\n\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mwarn:\033[0m %s\n' "$*" >&2; }
die() {
    printf '\033[1;31merror:\033[0m %s\n' "$*" >&2
    exit 1
}

list_runs() {
    find "$RUNS_DIR" -maxdepth 1 -type f -printf '%f\n' | sort
}

usage() {
    cat <<EOF
dev-env - set up this machine

usage: dev-env <command>

commands:
  link [--force]  symlink the active profile's packages into \$HOME
                  --force moves conflicting real files to a backup first
  unlink          remove those symlinks
  doctor          check this machine for problems; non-zero exit if any
  profile [name]  show or pin the session profile (hypr, i3)
  all             link, then run every installer
  <name>...       run only the named installers
  --list, -l      list available installers
  --help, -h      this message

installers:
$(list_runs | sed 's/^/  /')

Running with no arguments prints this help. Use 'all' to provision the
machine - it installs packages system-wide and is not what you want to
trigger by accident.
EOF
}

ensure_stow() {
    command -v stow >/dev/null && return 0

    info "stow is required for linking; installing it"
    source "$DEV_ENV_HOME/lib/platform.sh"
    install_packages stow
    hash -r

    command -v stow >/dev/null || die "stow install failed"
}

# stow refuses to overwrite anything already in place. The usual blocker on a
# machine that predates this repo is a symlink into an older dotfiles dir, so
# clear those out; anything else is a real file and the user's call.
clear_stale_links() {
    local target conflicts=0 pkg

    for pkg in $(active_packages); do
    while IFS= read -r -d '' src; do
        target="$HOME/${src#"$DEV_ENV_HOME/$pkg/"}"

        [[ -L "$target" ]] || continue

        local dest
        dest="$(readlink -f "$target" || true)"

        # Already pointing into this repo: stow will no-op, leave it.
        [[ "$dest" == "$DEV_ENV_HOME"/* ]] && continue

        warn "replacing stale link: $target -> $dest"
        rm "$target"
        conflicts=$((conflicts + 1))
    done < <(find "$DEV_ENV_HOME/$pkg" -mindepth 1 -print0)
    done

    ((conflicts)) && info "cleared $conflicts stale link(s)"
    return 0
}

# Real files - not links - block stow entirely. Every fresh machine has them:
# .profile and friends come from /etc/skel when the account is created. Moving
# them aside is safe and reversible; overwriting them silently would not be,
# and stow --adopt is worse still since it pulls the machine's copy *into* the
# repo, overwriting what is tracked here.
handle_conflicts() {
    local pkg rel target
    local -a conflicts=()

    for pkg in $(active_packages); do
        while IFS= read -r rel; do
            target="$HOME/$rel"
            [[ -e "$target" && ! -L "$target" ]] && conflicts+=("$rel")
        done < <(find "$DEV_ENV_HOME/$pkg" -type f \
            -not -path '*/.git/*' -not -name '.git' -printf '%P\n')
    done

    ((${#conflicts[@]})) || return 0

    if ((FORCE_LINK == 0)); then
        warn "these already exist as real files and would block stow:"
        printf '  ~/%s\n' "${conflicts[@]}" >&2
        die "inspect them, then re-run: ./dev-env link --force  (moves them to a backup)"
    fi

    local backup="$HOME/.local/share/dev-env/backup/$(date +%Y%m%d-%H%M%S)"
    info "backing up ${#conflicts[@]} conflicting file(s) to ${backup/#$HOME/\~}"

    for rel in "${conflicts[@]}"; do
        mkdir -p "$backup/$(dirname "$rel")"
        mv "$HOME/$rel" "$backup/$rel"
        echo "  ~/$rel"
    done
}

do_link() {
    ensure_stow
    clear_stale_links
    handle_conflicts

    local pkg
    for pkg in $(active_packages); do
        info "linking $pkg -> $HOME"

        # --no-folding keeps ~/.config and ~/.local as real dirs and links the
        # leaves, so unrelated configs living there are left alone.
        stow --target="$HOME" --dir="$DEV_ENV_HOME" --no-folding --restow "$pkg"

        # Tracked scripts need the exec bit; git only records it if it was set
        # at commit time, and stow just mirrors whatever is on disk.
        [[ -d "$DEV_ENV_HOME/$pkg/.local/scripts" ]] &&
            find "$DEV_ENV_HOME/$pkg/.local/scripts" -type f -exec chmod +x {} +
    done

    info "linked"
}

do_unlink() {
    ensure_stow
    local pkg
    for pkg in $(active_packages); do
        info "unlinking $pkg"
        stow --target="$HOME" --dir="$DEV_ENV_HOME" --delete "$pkg"
    done
}

DOCTOR_PROBLEMS=0

ok() { printf '  \033[1;32mok\033[0m    %s\n' "$*"; }
bad() {
    printf '  \033[1;31mfail\033[0m  %s\n' "$*"
    DOCTOR_PROBLEMS=$((DOCTOR_PROBLEMS + 1))
}
hint() { printf '        \033[2m%s\033[0m\n' "$*"; }

# Everything stow is expected to link. .git is excluded because stow ignores it
# by default, and for the nvim submodule it is a file rather than a directory.
env_files() {
    local pkg
    for pkg in $(active_packages); do
        find "$DEV_ENV_HOME/$pkg" -type f \
            -not -path '*/.git/*' -not -name '.git' \
            -printf '%P\n'
    done | sort -u
}

# Same list, but paired with the package each file came from, so callers can
# resolve a $HOME-relative path back to its source.
env_files_with_pkg() {
    local pkg
    for pkg in $(active_packages); do
        find "$DEV_ENV_HOME/$pkg" -type f \
            -not -path '*/.git/*' -not -name '.git' \
            -printf "$pkg %P\n"
    done | sort -u -k2
}

check_profile() {
    local profile
    profile="$(detect_profile)"

    if [[ -z "$profile" ]]; then
        bad "no session profile detected (neither hyprctl nor i3 found)"
        hint "install a session, or pin one: ./dev-env profile hypr"
    elif [[ -d "$DEV_ENV_HOME/env-$profile" ]]; then
        ok "profile: $profile ($(active_packages | tr '\n' ' '))"
    else
        bad "profile '$profile' has no env-$profile directory"
    fi
}

check_stow() {
    if command -v stow >/dev/null; then
        ok "stow present ($(stow --version | head -1))"
    else
        bad "stow not installed"
        hint "./dev-env link installs it automatically"
    fi
}

# Each file under env/ should exist at $HOME as a symlink resolving back here.
check_links() {
    local rel target src missing=0 conflict=0 foreign=0 broken=0 linked=0 pkg_map
    pkg_map="$(env_files_with_pkg)"

    while IFS= read -r rel; do
        target="$HOME/$rel"
        src="$DEV_ENV_HOME/$(awk -v r="$rel" '$2 == r {print $1; exit}' <<<"$pkg_map")/$rel"

        if [[ -L "$target" ]]; then
            if [[ ! -e "$target" ]]; then
                bad "dangling link: ~/$rel"
                broken=$((broken + 1))
            elif [[ "$(readlink -f "$target")" != "$(readlink -f "$src")" ]]; then
                bad "links elsewhere: ~/$rel -> $(readlink "$target")"
                foreign=$((foreign + 1))
            else
                linked=$((linked + 1))
            fi
        elif [[ -e "$target" ]]; then
            bad "real file blocks stow: ~/$rel"
            hint "inspect it, then delete it and re-run ./dev-env link"
            conflict=$((conflict + 1))
        else
            bad "not linked: ~/$rel"
            missing=$((missing + 1))
        fi
    done < <(env_files)

    ((missing + conflict + foreign + broken == 0)) &&
        ok "$linked files linked from env/"

    ((missing)) && hint "$missing missing - run ./dev-env link"
    return 0
}

# Files that moved or were deleted inside the repo leave links behind at $HOME:
# unstow only knows about the package's *current* contents, so it cannot clean
# them up. Scan just the directories the packages populate, not all of $HOME.
#
# Deliberately walks *every* env-* package, not only the active ones. Switching
# profiles - or splitting one package into several - strands links in
# directories the active profile no longer touches, and scanning only the
# active set would report those as clean.
check_orphans() {
    local -a dirs=()
    local rel d pkg found=0

    for pkg in "$DEV_ENV_HOME"/env-*; do
        [[ -d "$pkg" ]] || continue
        while IFS= read -r rel; do
            dirs+=("$HOME/$(dirname "$rel")")
        done < <(find "$pkg" -type f -not -path '*/.git/*' -not -name '.git' -printf '%P\n')
    done

    while IFS= read -r d; do
        [[ -d "$d" ]] || continue
        while IFS= read -r l; do
            [[ -e "$l" ]] && continue
            case "$(readlink "$l")" in
                *personal/dev/* | *.dotfiles*)
                    bad "orphaned link: ${l/#$HOME/\~} -> $(readlink "$l")"
                    hint "left over from a moved/deleted file; rm it"
                    found=$((found + 1))
                    ;;
            esac
        done < <(find "$d" -maxdepth 1 -type l 2>/dev/null)
    done < <(printf '%s\n' "${dirs[@]}" | sort -u)

    ((found == 0)) && ok "no orphaned links"
    return 0
}

check_submodules() {
    local line status path

    # IFS= matters: read would otherwise strip the leading status character
    # when it is a space (the "clean" case).
    while IFS= read -r line; do
        status="${line:0:1}"
        path="$(echo "${line:1}" | awk '{print $2}')"

        case "$status" in
            -) bad "submodule not initialized: $path"
               hint "git submodule update --init $path" ;;
            +) bad "submodule at a different commit than recorded: $path"
               hint "commit the pointer, or: git submodule update $path" ;;
            U) bad "submodule has merge conflicts: $path" ;;
            *) ok "submodule $path" ;;
        esac

        if [[ -d "$DEV_ENV_HOME/$path" ]]; then
            if [[ -n "$(git -C "$DEV_ENV_HOME/$path" status --porcelain 2>/dev/null)" ]]; then
                bad "submodule has uncommitted changes: $path"
                hint "dev-commit handles submodule-then-superproject ordering"
            fi
        fi
    done < <(git -C "$DEV_ENV_HOME" submodule status 2>/dev/null)

    return 0
}

check_repo() {
    local ahead

    if [[ -n "$(git -C "$DEV_ENV_HOME" status --porcelain)" ]]; then
        bad "repo has uncommitted changes"
        hint "dev-commit"
    else
        ok "repo clean"
    fi

    if git -C "$DEV_ENV_HOME" remote get-url origin >/dev/null 2>&1; then
        ahead="$(git -C "$DEV_ENV_HOME" rev-list --count @{u}..HEAD 2>/dev/null || echo 0)"
        if [[ "$ahead" != "0" ]]; then
            bad "$ahead commit(s) not pushed"
        else
            ok "pushed"
        fi
    else
        bad "no origin remote"
    fi

    return 0
}

# Catches the stale-shell case: the profile is correct on disk but the running
# shell predates it, so nothing under .local/scripts resolves.
check_path() {
    local d
    for d in "$HOME/.local/scripts" "$HOME/.local/bin"; do
        case ":$PATH:" in
            *":$d:"*) ok "on PATH: ${d/#$HOME/\~}" ;;
            *)
                bad "not on PATH: ${d/#$HOME/\~}"
                hint "your shell predates the profile change - run: exec zsh"
                ;;
        esac
    done
    return 0
}

do_doctor() {
    info "profile"
    check_profile
    info "tooling"
    check_stow
    info "PATH"
    check_path
    info "links"
    check_links
    check_orphans
    info "submodules"
    check_submodules
    info "repo"
    check_repo

    if ((DOCTOR_PROBLEMS)); then
        printf '\n\033[1;31m%d problem(s) found\033[0m\n' "$DOCTOR_PROBLEMS"
        return 1
    fi

    printf '\n\033[1;32mall good\033[0m\n'
    return 0
}

run_one() {
    local name="$1"
    local script="$RUNS_DIR/$name"

    [[ -f "$script" ]] || die "no such installer: $name (try --list)"

    info "run: $name"
    bash "$script"
}

run_all() {
    local name
    for name in $(list_runs); do
        run_one "$name"
    done
}

main() {
    case "${1:-}" in
        --list | -l)
            list_runs
            ;;
        link)
            [[ "${2:-}" == "--force" || "${2:-}" == "-f" ]] && FORCE_LINK=1
            do_link
            ;;
        unlink)
            do_unlink
            ;;
        doctor)
            do_doctor
            ;;
        profile)
            # main dispatches on $1 without shifting, so the argument is $2.
            if [[ -n "${2:-}" ]]; then
                [[ -d "$DEV_ENV_HOME/env-$2" ]] || die "no such profile: $2"
                printf '%s\n' "$2" >"$PROFILE_FILE"
                info "profile pinned to $2 - run ./dev-env link to apply"
            else
                printf '%s\n' "$(detect_profile)"
            fi
            ;;
        all)
            [[ "${2:-}" == "--force" || "${2:-}" == "-f" ]] && FORCE_LINK=1
            do_link
            run_all
            info "done"
            ;;
        "" | -h | --help | help)
            usage
            ;;
        *)
            local name
            for name in "$@"; do
                run_one "$name"
            done
            ;;
    esac
}

main "$@"
